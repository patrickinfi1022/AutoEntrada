# Public address on which browsers can reach UDP/TCP 8555.
GO2RTC_PUBLIC_IP=MEDIA_SERVER_PUBLIC_IP
GO2RTC_WEBRTC_PORT=8555

# When FastAPI runs directly on this Windows/Linux host. If it is a container
# attached to autoentrada-media-backplane, use http://go2rtc:1984 instead.
GO2RTC_API_URL=http://127.0.0.1:1984

# Generate independent secrets for production. Never use these placeholders.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
CAMERA_CREDENTIALS_KEY=generate-a-fernet-key
JWT_ISSUER=autoentrada
JWT_AUDIENCE=autoentrada-api
CORS_ORIGINS=https://app.example.com
