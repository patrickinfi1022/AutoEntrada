JWT_AUDIENCE=autoentrada-api
CAMERA_CREDENTIALS_KEY=GENERATE_A_FERNET_KEY_AND_STORE_IN_A_SECRET_MANAGER
CORS_ORIGINS=https://app.example.com
GO2RTC_API_URL=http://go2rtc:1984
